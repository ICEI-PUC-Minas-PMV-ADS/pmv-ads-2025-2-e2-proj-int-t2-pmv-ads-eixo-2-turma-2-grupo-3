@model IEnumerable<Cuida_.Models.Consulta>

    @{
    ViewData["Title"] = "Minhas Consultas";
    Layout = null;
    }

    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
}
    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
}

    <!DOCTYPE html>
    <html lang="pt-br">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"]</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

        <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f5f5f5;
                padding: 30px 5%;
                margin-left: 50px;
            }

            .nome-paciente {
                text-transform: uppercase;
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 8px;
                color: #0d99ff;
            }

            .card {
                box-shadow: 1px 1px 10px -5px black !important;
                border-radius: 12px;
            }

            h1 {
                font-weight: 600;
            }
        </style>
    </head>

    <body>
        @await Html.PartialAsync("_MenuPartial")
        <a id="toggleSidebar" href="/home" class="toggle-btn">
            <i class="bi bi-chevron-left"></i>
        </a>

        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Minhas Consultas</h1>
            </div>

            <div class="row g-3">
                @if (!Model.Any())
            {
                <div class="col-12 text-center mt-4">
                    <div class="alert alert-info border-0 shadow-sm" style="max-width: 500px; margin: 0 auto;">
                        <i class="bi bi-info-circle me-2"></i>
                        Você não possui consultas agendadas.
                    </div>
                </div>
            }
            else
            {
                @foreach (var consulta in Model)
                {
                <div class="col-md-4 col-sm-6">
                    <div class="card p-3">
                        <h3 class="nome-paciente">@consulta.Paciente?.Nome</h3>

                        <p><b>Médico:</b> @consulta.Medico?.Nome</p>
                        <p><b>Data:</b> @consulta.Data.ToString("dd/MM/yyyy")</p>
                        <p><b>Horário:</b> @consulta.Horario.ToString("HH:mm")</p>

                        <div class="d-flex justify-content-end mt-2 pt-2 border-top">

                            <!-- BOTÃO DE EXCLUIR -->
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalExcluir"
                                    data-id="@consulta.IdConsulta"
                                    data-nome="@consulta.Paciente?.Nome">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    </div>
                </div>
                }
            }
            </div>
        </div>

        <!-- Modal EXCLUIR -->
        <div class="modal fade" id="modalExcluir" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Cancelar consulta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center">
                        <p>Tem certeza que deseja cancelar a consulta de <strong id="nomeExcluir"></strong>?</p>

                        <form id="formExcluir" method="post" asp-controller="Paciente" asp-action="Delete">
                            <input type="hidden" id="idExcluir" name="id" />
                            <label class="form-label d-block text-muted">Essa ação não pode ser desfeita.</label>

                            <button type="submit" class="btn btn-danger px-4 me-2">Confirmar</button>
                            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Fechar</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
        const modalExcluir = document.getElementById('modalExcluir');
        modalExcluir.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;

            document.getElementById('idExcluir').value = button.getAttribute('data-id');
            document.getElementById('nomeExcluir').textContent = button.getAttribute('data-nome');
        });
        </script>

    </body>
</html>
