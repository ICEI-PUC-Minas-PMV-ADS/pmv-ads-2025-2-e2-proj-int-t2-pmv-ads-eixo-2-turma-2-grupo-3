@model Cuida_.Models.ViewModels.TrocarSenhaViewModel

@{
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" />

@await Html.PartialAsync("_MenuPartial")

<style>
    body, html {
        height: 100%;
        margin: 0;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        font-family: 'Segoe UI', sans-serif;
    }

    .main-content {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .password-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 50px 40px;
        border-radius: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 600px;
        transition: all 0.3s ease;
    }

    .password-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }

    .password-card h4 {
        font-weight: 700;
        color: #333;
        text-align: center;
        margin-bottom: 40px;
        font-size: 2rem;
    }

    .form-control {
        border-radius: 15px;
        padding: 14px;
        font-weight: 500;
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);
        transition: all 0.3s;
    }

    label.fw-bold {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
    }

    .btn-alterar {
        border-radius: 15px;
        padding: 12px 35px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        background-color: #0D99FF;
        color: #fff;
        border: none;
        box-shadow: 0 5px 15px rgba(13,153,255,0.3);
    }

    .btn-alterar:hover {
        background-color: #0b80cc;
        box-shadow: 0 8px 20px rgba(13,153,255,0.5);
    }

    .text-end {
        margin-top: 40px;
    }

    .row.g-3 > .col-12 {
        margin-bottom: 20px;
    }
</style>

<div class="main-content">
    <div class="password-card">
        <h4>Alterar Senha</h4>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["MensagemSucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="MudarSenha" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UsuarioId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="SenhaAtual" class="fw-bold"></label>
                    <input asp-for="SenhaAtual" class="form-control" type="password" placeholder="Digite sua senha atual" />
                    <span asp-validation-for="SenhaAtual" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="NovaSenha" class="fw-bold"></label>
                    <input asp-for="NovaSenha" class="form-control" type="password" placeholder="Digite a nova senha" />
                    <span asp-validation-for="NovaSenha" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ConfirmarSenha" class="fw-bold"></label>
                    <input asp-for="ConfirmarSenha" class="form-control" type="password" placeholder="Confirme a nova senha" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                </div>
            </div>

            <div class="text-end">
                <a asp-action="Perfil" class="btn btn-outline-secondary me-3">Cancelar</a>
                <button type="submit" class="btn btn-alterar">MUDAR SENHA</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}
