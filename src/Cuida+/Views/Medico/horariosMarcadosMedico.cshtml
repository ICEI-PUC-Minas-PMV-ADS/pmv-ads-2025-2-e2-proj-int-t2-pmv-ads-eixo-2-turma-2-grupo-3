@model IEnumerable<Cuida_.Models.Consulta>

    @{
    ViewData["Title"] = "Consultas";
    Layout = null;
    }

    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
}
    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
}

    <!DOCTYPE html>
    <html lang="pt-br">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"]</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

        <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f5f5f5;
                padding: 30px 5%;
                margin-left: 50px;
            }

            .nome-paciente {
                text-transform: uppercase;
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 8px;
                color: #0d99ff;
            }

            .card {
                box-shadow: 1px 1px 10px -5px black !important;
                border-radius: 12px;
            }

            h1 {
                font-weight: 600;
            }
        </style>
    </head>

    <body>
        @await Html.PartialAsync("_MenuPartial")
        <a id="toggleSidebar" href="/home" class="toggle-btn">
            <i class="bi bi-chevron-left"></i>
        </a>

        <div class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Consultas</h1>
            </div>

            <div class="row g-3">
                @if (!Model.Any())
            {
                <div class="col-12 text-center mt-4">
                    <div class="alert alert-info border-0 shadow-sm" role="alert"
                         style="max-width: 500px; margin: 0 auto;">
                        <i class="bi bi-info-circle me-2"></i>
                        Nenhuma consulta cadastrada no momento.
                    </div>
                </div>
            }
            else
            {
                @foreach (var consulta in Model)
                {
                <div class="col-md-4 col-sm-6">
                    <div class="card p-3">
                        <h3 class="nome-paciente">@consulta.Paciente?.Nome</h3>

                        <p><b>Médico:</b> @consulta.Medico?.Nome</p>
                        <p><b>Data:</b> @consulta.Data.ToString("dd/MM/yyyy")</p>
                        <p><b>Horário:</b> @consulta.Horario.ToString("HH:mm")</p>

                        <div class="d-flex justify-content-end mt-2 pt-2 border-top">
                            <button type="button"
                                    class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditar"
                                    data-id="@consulta.IdConsulta"
                                    data-data='@consulta.Data.ToString("yyyy-MM-dd")'
                                    data-horario='@consulta.Horario.ToString("HH:mm")'>
                                <i class="bi bi-pencil"></i>
                            </button>
                        </div>
                    </div>
                </div>
                }
            }
            </div>
        </div>

        <!-- Modal EDITAR -->
        <div class="modal fade" id="modalEditar" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Editar horário</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <form method="post" asp-controller="Medico" asp-action="Edit">
                            <input type="hidden" id="editId" name="IdConsulta" />

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label>Data</label>
                                    <input type="date" id="editData" name="Data" class="form-control" required />
                                </div>

                                <div class="col-md-12 mt-2">
                                    <label>Horário</label>
                                    <input type="time" id="editHorario" name="Horario" class="form-control" required />
                                </div>
                            </div>

                            <div class="mt-4 text-center">
                                <button type="submit" class="btn btn-primary px-5 py-2">Salvar</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            const modalEditar = document.getElementById('modalEditar');
            modalEditar.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;

                document.getElementById('editId').value = button.getAttribute('data-id');
                document.getElementById('editData').value = button.getAttribute('data-data');
                document.getElementById('editHorario').value = button.getAttribute('data-horario');
            });
        </script>

    </body>
</html>
